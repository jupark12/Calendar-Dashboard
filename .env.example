# Copy to .env. Node loads this file; no secrets belong in VITE_* variables.
DEMO_MODE=true
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/home-hq.sqlite
# Production: set DEMO_MODE=false, NODE_ENV=production, COOKIE_SECURE=true.
# Use distinct passwords: admin at least 20 characters, display at least 12.
# Generate random passwords with: openssl rand -base64 32
ADMIN_PASSWORD=
DISPLAY_PASSWORD=
COOKIE_SECURE=false
# Exact public origin, no trailing slash. Required outside demo mode.
APP_ORIGIN=http://localhost:3000
# Maps settings calendar IDs to Google SECRET iCal URLs; server only.
CALENDAR_FEEDS={}
# Identify your application to NWS with a real contact address.
WEATHER_USER_AGENT=HomeHQ/1.0 (contact: you@example.com)

# Used by Docker Compose / Caddy in production:
# DOMAIN=home.example.com
