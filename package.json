{
  "name": "home-hq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "validate": "npm run check && npm run lint && npm test && npm run build && npm run build:aws && npm run test:aws-artifacts",
    "format": "prettier --write src server shared tests public/sw.js",
    "build:aws": "node scripts/build-aws.mjs",
    "aws:config": "tsx scripts/upload-config.ts",
    "aws:import": "tsx scripts/import-data.ts",
    "vercel:configure": "node scripts/configure-vercel.mjs",
    "test:aws-artifacts": "node scripts/test-aws-artifacts.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "express": "^5.1.0",
    "node-ical": "^0.27.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "tsx": "^4.20.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
